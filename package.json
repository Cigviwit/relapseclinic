{
  "name": "relapseclinic",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs && npm --prefix functions test",
    "test:emulator": "firebase emulators:exec --only auth,firestore,storage --project demo-relapseclinic \"node --experimental-strip-types --test --test-concurrency=1 tests/emulator/*.test.mjs\"",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run test:emulator"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "html-to-image": "1.11.13",
    "lucide-react": "^1.31.0",
    "qrcode-generator": "2.0.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.0.13"
  }
}
