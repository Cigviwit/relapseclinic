rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Who can do what. lib/permissions.ts is the same table for the screens; the rules are what enforce it.
    //   owner      everything in the clinic: staff, settings, corrections, activity log, data export
    //   doctor     clinical records, notes and their own prescriptions, plus bills and payments
    //   frontdesk  patients, booking, medical record form, reads prescriptions, bills, payments, closes the day
    //   billing    patients, booking, bills, payments, voids and corrections, closes the day
    //   platform   the platform administrator (auth claim): reads everything except visit notes;
    //              writes clinics, patients and appointments only, never clinical or billing records
    // users/{uid}: uid, email, name, clinicId, role, doctorId, active, createdAt. Written by Cloud Functions only.
    // Accounts from before roles existed have no role or name: they count as an active owner.
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.get('platformAdmin', false) == true; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function profile() { return get(profilePath()).data; }
    function clinicMember(clinicId) {
      return signedIn() && exists(profilePath()) && profile().clinicId == clinicId && profile().get('active', true) == true;
    }
    function role() { return profile().get('role', 'owner'); }
    function hasRole(clinicId, roles) { return clinicMember(clinicId) && role() in roles; }
    function staffName() { return profile().get('name', profile().email); }
    function canAccess(clinicId) { return isAdmin() || clinicMember(clinicId); }
    function canReadClinical(clinicId) { return isAdmin() || hasRole(clinicId, ['owner','doctor','frontdesk']); }
    function canReadBilling(clinicId) { return isAdmin() || hasRole(clinicId, ['owner','doctor','frontdesk','billing']); }
    function stampedNow(data) { return data.updatedBy == request.auth.uid && data.updatedAt == request.time; }

    function text(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function optionalText(data, field, max) { return !(field in data) || text(data[field], max); }
    function upTo(data, field, max) { return !(field in data) || (data[field] is string && data[field].size() <= max); }
    function isDate(value) { return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function patientInClinic(patientId, clinicId) {
      return get(/databases/$(database)/documents/patients/$(patientId)).data.clinicId == clinicId;
    }
    function sameClinic() { return request.resource.data.clinicId == resource.data.clinicId; }

    function validClinic(data, id) {
      return data.keys().hasAll(['id','name','address','phone','timezone','opens','closes','doctors'])
        && data.keys().hasOnly(['id','name','address','phone','timezone','opens','closes','doctors','doctorDigestEnabled','doctorDigestTime','rxPad','prescriptionsEnabled','billingEnabled','billing','autoLockMinutes','closedDates','updatedBy'])
        && (!('rxPad' in data) || (data.rxPad is map && data.rxPad.size() <= 10))
        && (!('prescriptionsEnabled' in data) || data.prescriptionsEnabled is bool)
        && (!('billingEnabled' in data) || data.billingEnabled is bool)
        && (!('billing' in data) || (data.billing is map && data.billing.size() <= 6 && data.billing.fees is list && data.billing.fees.size() <= 200))
        && (!('closedDates' in data) || (data.closedDates is list && data.closedDates.size() <= 100))
        && (!('autoLockMinutes' in data) || (data.autoLockMinutes is int && data.autoLockMinutes >= 0 && data.autoLockMinutes <= 240))
        && data.id == id && text(data.name, 100) && text(data.address, 250)
        && text(data.phone, 20) && text(data.timezone, 80)
        && text(data.opens, 5) && text(data.closes, 5)
        && data.doctors is list && data.doctors.size() > 0 && data.doctors.size() <= 30
        && (!('doctorDigestEnabled' in data) || data.doctorDigestEnabled is bool)
        && (!('doctorDigestTime' in data) || (data.doctorDigestTime is string && data.doctorDigestTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && data.updatedBy == request.auth.uid;
    }
    function keepsPrescriptionSwitch() {
      return request.resource.data.get('prescriptionsEnabled', false) == resource.data.get('prescriptionsEnabled', false);
    }
    function keepsBillingSwitch() {
      return request.resource.data.get('billingEnabled', false) == resource.data.get('billingEnabled', false);
    }
    function validPatient(data, id) {
      return data.keys().hasAll(['id','clinicId','name','phone','consent','updatedBy','updatedAt'])
        && data.keys().hasOnly(['id','clinicId','name','phone','consent','language','familyId','updatedBy','updatedAt'])
        && optionalText(data, 'familyId', 100)
        && data.id == id && text(data.clinicId, 100) && text(data.name, 100)
        && text(data.phone, 20) && data.consent is bool
        && (!('language' in data) || data.language in ['en','mr','hi'])
        && stampedNow(data);
    }
    // Booking and rescheduling go through the bookAppointment function, which checks for clashes in a transaction.
    // A browser may only record what happened to a booked visit.
    function validAppointmentOutcome() {
      let after = request.resource.data;
      return after.diff(resource.data).affectedKeys().hasOnly(['status','finishedAt','updatedBy','updatedAt'])
        && after.status in ['completed','cancelled','missed'] && resource.data.status in ['scheduled','missed']
        && (!('finishedAt' in after) || after.finishedAt == request.time)
        && stampedNow(after);
    }
    // Moving a booked visit through the queue: arrived, with the doctor, or undoing an arrival made by mistake.
    function validVisitStep() {
      let after = request.resource.data;
      let before = resource.data;
      let changed = after.diff(before).affectedKeys();
      return before.status == 'scheduled' && after.status == 'scheduled' && stampedNow(after) && (
        (!('stage' in before) && after.get('stage', '') == 'arrived' && after.arrivedAt == request.time && changed.hasOnly(['stage','arrivedAt','updatedBy','updatedAt']))
        || (before.get('stage', '') == 'arrived' && after.get('stage', '') == 'with_doctor' && after.startedAt == request.time && changed.hasOnly(['stage','startedAt','updatedBy','updatedAt']))
        || ('stage' in before && !('stage' in after) && !('arrivedAt' in after) && !('startedAt' in after) && changed.hasOnly(['stage','arrivedAt','startedAt','updatedBy','updatedAt']))
      );
    }
    function validReminder(data, id) {
      return data.keys().hasAll(['id','clinicId','patientId','date','time','message','status'])
        && data.keys().hasOnly(['id','clinicId','patientId','date','time','message','status','sentAt','sentMessage'])
        && data.id == id && text(data.clinicId, 100) && text(data.patientId, 100)
        && text(data.date, 10) && text(data.time, 5) && text(data.message, 1000)
        && data.status in ['scheduled','simulated-sent','cancelled']
        && optionalText(data, 'sentAt', 40) && optionalText(data, 'sentMessage', 1300);
    }

    // Prescriptions: a draft may change; a final one never does. A mistake is fixed by a new prescription whose `amends` names the old one.
    // sentAt is written by the sendPrescription function only.
    function validPrescription(data, id) {
      return data.keys().hasAll(['id','clinicId','patientId','doctorId','date','medicines','createdAt','status','updatedBy','updatedAt'])
        && data.keys().hasOnly(['id','clinicId','patientId','doctorId','appointmentId','date','age','sex','specialty','vitals','history','complaints','teeth','findings','diagnosis','procedures','plan','medicines','advice','tests','followUp','createdAt','status','amends','finalizedAt','finalizedBy','allergyOverride','mergedFrom','updatedBy','updatedAt'])
        && (!('allergyOverride' in data) || (data.allergyOverride is list && data.allergyOverride.size() <= 40))
        && (!('teeth' in data) || (data.teeth is list && data.teeth.size() <= 52))
        && data.id == id && text(data.clinicId, 100) && text(data.patientId, 100)
        && text(data.doctorId, 100) && isDate(data.date) && text(data.createdAt, 40)
        && data.medicines is list && data.medicines.size() <= 40
        && (!('vitals' in data) || data.vitals is map)
        && (!('complaints' in data) || (data.complaints is string && data.complaints.size() <= 2000))
        && (!('diagnosis' in data) || (data.diagnosis is string && data.diagnosis.size() <= 1000))
        && (!('advice' in data) || (data.advice is string && data.advice.size() <= 3000))
        && (!('tests' in data) || (data.tests is string && data.tests.size() <= 1000))
        && data.status in ['draft','final']
        && (data.status == 'final'
            ? (data.finalizedAt == request.time && data.finalizedBy == staffName())
            : (!('finalizedAt' in data) && !('finalizedBy' in data)))
        && stampedNow(data)
        && patientInClinic(data.patientId, data.clinicId);
    }
    function mayWritePrescription(data) {
      return hasRole(data.clinicId, ['owner','doctor'])
        && (role() == 'owner' || data.doctorId == profile().get('doctorId', ''));
    }
    function amendsSamePatient(data) {
      return !('amends' in data) || (text(data.amends, 100)
        && get(/databases/$(database)/documents/prescriptions/$(data.amends)).data.patientId == data.patientId
        && get(/databases/$(database)/documents/prescriptions/$(data.amends)).data.clinicId == data.clinicId);
    }
    function prescriptionsOn(clinicId) {
      return get(/databases/$(database)/documents/clinics/$(clinicId)).data.get('prescriptionsEnabled', false) == true;
    }

    function validPatientRecord(data, id) {
      return data.keys().hasAll(['id','clinicId','patientId','allergyStatus','allergies','version','updatedAt','updatedBy'])
        && data.keys().hasOnly(['id','clinicId','patientId','fileNo','dob','dobEstimated','sex','bloodGroup','occupation','address','emergencyName','emergencyPhone','allergyStatus','allergies','conditions','medications','surgeries','familyHistory','tobacco','alcohol','notes','version','updatedAt','updatedBy'])
        && data.id == id && data.patientId == id && text(data.clinicId, 100)
        && data.allergyStatus in ['unknown','none','known']
        && data.allergies is list && data.allergies.size() <= 40
        && (data.allergyStatus == 'known') == (data.allergies.size() > 0)
        && data.version is int
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid
        && (!('dob' in data) || data.dob == '' || data.dob.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (!('dobEstimated' in data) || data.dobEstimated is bool)
        && (!('sex' in data) || data.sex in ['','M','F','O'])
        && (!('bloodGroup' in data) || data.bloodGroup in ['','A+','A-','B+','B-','AB+','AB-','O+','O-'])
        && (!('tobacco' in data) || data.tobacco in ['','never','former','current'])
        && (!('alcohol' in data) || data.alcohol in ['','never','former','current'])
        && upTo(data, 'fileNo', 40) && upTo(data, 'occupation', 100) && upTo(data, 'address', 300)
        && upTo(data, 'emergencyName', 100) && upTo(data, 'emergencyPhone', 20)
        && upTo(data, 'conditions', 2000) && upTo(data, 'medications', 2000) && upTo(data, 'surgeries', 2000)
        && upTo(data, 'familyHistory', 2000) && upTo(data, 'notes', 3000);
    }
    function validPatientNote(data, id) {
      return data.keys().hasAll(['id','clinicId','patientId','doctorId','date','text','createdAt','createdBy','createdByName'])
        && data.keys().hasOnly(['id','clinicId','patientId','doctorId','date','text','vitals','corrects','appointmentId','mergedFrom','createdAt','createdBy','createdByName'])
        && optionalText(data, 'appointmentId', 100)
        && data.id == id && text(data.clinicId, 100) && text(data.patientId, 100) && text(data.doctorId, 100)
        && isDate(data.date)
        && data.text is string && data.text.size() <= 5000
        && (!('vitals' in data) || (data.vitals is map && data.vitals.size() <= 5))
        && optionalText(data, 'corrects', 100)
        && data.createdAt == request.time && data.createdBy == request.auth.uid && data.createdByName == staffName()
        && patientInClinic(data.patientId, data.clinicId);
    }

    // Billing: amounts are whole paise. Bills, ledger entries and closings are never deleted and a closed day takes no new entries.
    // The name on each record comes from the signed-in person's profile, so it cannot be typed in.
    function billingStaff(clinicId, roles) {
      return hasRole(clinicId, roles) && get(/databases/$(database)/documents/clinics/$(clinicId)).data.get('billingEnabled', false) == true;
    }
    function dayOpen(clinicId, date) { return !exists(/databases/$(database)/documents/dayClosings/$(clinicId + '_' + date)); }
    function money(value) { return value is int && value >= 0 && value <= 1000000000; }
    function validBill(data, id) {
      return data.keys().hasAll(['id','clinicId','patientId','doctorId','date','lines','subtotal','discount','tax','total','status','createdBy','createdAt','createdByUid'])
        && data.keys().hasOnly(['id','clinicId','patientId','doctorId','appointmentId','date','lines','subtotal','discount','tax','total','note','status','createdBy','createdAt','createdByUid'])
        && data.id == id && text(data.clinicId, 100) && text(data.patientId, 100) && text(data.doctorId, 100)
        && isDate(data.date) && data.status == 'active' && optionalText(data, 'appointmentId', 100) && upTo(data, 'note', 500)
        && data.lines is list && data.lines.size() > 0 && data.lines.size() <= 50
        && money(data.subtotal) && money(data.discount) && money(data.tax) && money(data.total)
        && data.discount <= data.subtotal && data.total == data.subtotal - data.discount + data.tax
        && data.createdBy == staffName() && data.createdAt == request.time && data.createdByUid == request.auth.uid
        && patientInClinic(data.patientId, data.clinicId) && dayOpen(data.clinicId, data.date);
    }
    function reversesOriginal(data) {
      let original = get(/databases/$(database)/documents/ledgerEntries/$(data.reverses)).data;
      return data.id == 'rev_' + data.reverses && original.clinicId == data.clinicId && original.patientId == data.patientId
        && original.amount == data.amount && original.method == data.method && original.kind == data.reversesKind;
    }
    function validLedgerEntry(data, id) {
      return data.keys().hasAll(['id','clinicId','patientId','kind','method','amount','date','collectedBy','createdAt','createdByUid'])
        && data.keys().hasOnly(['id','clinicId','patientId','kind','billId','method','amount','date','reference','note','reverses','reversesKind','collectedBy','createdAt','createdByUid'])
        && data.id == id && text(data.clinicId, 100) && text(data.patientId, 100)
        && data.kind in ['payment','refund','reversal'] && data.method in ['cash','upi','card','other']
        && money(data.amount) && data.amount > 0 && isDate(data.date)
        && optionalText(data, 'billId', 100) && upTo(data, 'reference', 100) && upTo(data, 'note', 300)
        && data.collectedBy == staffName() && data.createdAt == request.time && data.createdByUid == request.auth.uid
        && (data.kind != 'refund' || !('billId' in data))
        && (data.kind == 'reversal' ? reversesOriginal(data) : !('reverses' in data) && !('reversesKind' in data))
        && patientInClinic(data.patientId, data.clinicId) && dayOpen(data.clinicId, data.date);
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow get, list: if isAdmin() || hasRole(resource.data.clinicId, ['owner']);
      allow create, update, delete: if false;
    }
    match /clinics/{id} {
      allow get: if canAccess(id);
      allow list: if isAdmin();
      // New clinics come from the createClinic function. Clinic owners edit their own settings; the feature switches are the administrator's.
      allow create: if false;
      allow update: if validClinic(request.resource.data, id)
        && (isAdmin() || (hasRole(id, ['owner']) && keepsPrescriptionSwitch() && keepsBillingSwitch()));
      allow delete: if false;
    }
    match /patients/{id} {
      allow get, list: if canAccess(resource.data.clinicId);
      allow create: if canAccess(request.resource.data.clinicId) && validPatient(request.resource.data, id);
      // A merged patient is closed: saving one would drop the merge and bring the duplicate back.
      allow update: if canAccess(resource.data.clinicId) && sameClinic() && validPatient(request.resource.data, id) && !('mergedInto' in resource.data);
      allow delete: if false;
    }
    match /appointments/{id} {
      allow get, list: if canAccess(resource.data.clinicId);
      allow create: if false;
      allow update: if canAccess(resource.data.clinicId) && (validAppointmentOutcome() || validVisitStep());
      allow delete: if false;
    }
    match /waitlist/{id} {
      allow get, list: if canAccess(resource.data.clinicId);
      allow create: if canAccess(request.resource.data.clinicId) && request.resource.data.keys().hasOnly(['id','clinicId','patientId','doctorId','note','status','createdAt','updatedBy','updatedAt'])
        && request.resource.data.id == id && request.resource.data.status == 'waiting' && text(request.resource.data.createdAt, 40)
        && request.resource.data.doctorId is string && upTo(request.resource.data, 'note', 200)
        && stampedNow(request.resource.data) && patientInClinic(request.resource.data.patientId, request.resource.data.clinicId);
      allow update: if canAccess(resource.data.clinicId) && resource.data.status == 'waiting' && request.resource.data.status in ['booked','removed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedBy','updatedAt']) && stampedNow(request.resource.data);
      allow delete: if false;
    }
    match /reminders/{id} {
      allow get, list: if canAccess(resource.data.clinicId);
      allow create: if canAccess(request.resource.data.clinicId) && validReminder(request.resource.data, id);
      allow update: if canAccess(resource.data.clinicId) && sameClinic() && validReminder(request.resource.data, id);
      allow delete: if false;
    }
    match /prescriptions/{id} {
      allow get, list: if canReadClinical(resource.data.clinicId);
      allow create: if mayWritePrescription(request.resource.data) && prescriptionsOn(request.resource.data.clinicId)
        && validPrescription(request.resource.data, id) && amendsSamePatient(request.resource.data);
      allow update: if resource.data.get('status', 'final') == 'draft' && sameClinic()
        && mayWritePrescription(request.resource.data) && prescriptionsOn(resource.data.clinicId)
        && request.resource.data.createdAt == resource.data.createdAt
        && validPrescription(request.resource.data, id) && amendsSamePatient(request.resource.data);
      allow delete: if false;
    }
    match /patientRecords/{id} {
      allow get, list: if canReadClinical(resource.data.clinicId);
      allow create: if hasRole(request.resource.data.clinicId, ['owner','doctor','frontdesk']) && validPatientRecord(request.resource.data, id)
        && request.resource.data.version == 1 && patientInClinic(id, request.resource.data.clinicId);
      allow update: if hasRole(resource.data.clinicId, ['owner','doctor','frontdesk']) && sameClinic() && validPatientRecord(request.resource.data, id)
        && request.resource.data.version == resource.data.version + 1;
      allow delete: if false;
    }
    // Free-text visit notes are the one thing the platform administrator cannot read.
    match /patientNotes/{id} {
      allow get, list: if hasRole(resource.data.clinicId, ['owner','doctor']);
      allow create: if hasRole(request.resource.data.clinicId, ['owner','doctor']) && validPatientNote(request.resource.data, id);
      allow update, delete: if false;
    }
    match /patientRecordAudit/{id} {
      allow get, list: if canReadClinical(resource.data.clinicId);
      allow create, update, delete: if false;
    }
    // Uploads, downloads and removals go through Cloud Functions, which check the caller's role. Browsers only read the list.
    match /patientFiles/{id} {
      allow get, list: if canReadClinical(resource.data.clinicId);
      allow create, update, delete: if false;
    }
    // The clinic's medicine list and prescription templates: one document per clinic, kept by those who prescribe.
    match /clinicCatalogs/{clinicId} {
      allow get: if canReadClinical(clinicId);
      allow create, update: if hasRole(clinicId, ['owner','doctor']) && request.resource.data.keys().hasOnly(['id','clinicId','medicines','templates','updatedBy','updatedAt'])
        && request.resource.data.id == clinicId && request.resource.data.clinicId == clinicId
        && request.resource.data.medicines is list && request.resource.data.medicines.size() <= 500
        && request.resource.data.templates is list && request.resource.data.templates.size() <= 100
        && stampedNow(request.resource.data);
      allow delete: if false;
    }
    function validPlan(data, id) {
      return data.keys().hasAll(['id','clinicId','patientId','doctorId','title','items','status','createdAt','version','updatedBy','updatedAt'])
        && data.keys().hasOnly(['id','clinicId','patientId','doctorId','title','items','status','createdAt','version','mergedFrom','updatedBy','updatedAt'])
        && data.id == id && text(data.doctorId, 100) && text(data.title, 100) && text(data.createdAt, 40)
        && data.items is list && data.items.size() > 0 && data.items.size() <= 60
        && data.status in ['active','closed'] && data.version is int && stampedNow(data);
    }
    // Treatment plans: doctors and owners decide treatment; front desk can read them to explain costs.
    match /treatmentPlans/{id} {
      allow get, list: if canReadClinical(resource.data.clinicId);
      allow create: if hasRole(request.resource.data.clinicId, ['owner','doctor']) && validPlan(request.resource.data, id)
        && request.resource.data.version == 1 && patientInClinic(request.resource.data.patientId, request.resource.data.clinicId);
      allow update: if hasRole(resource.data.clinicId, ['owner','doctor']) && sameClinic() && validPlan(request.resource.data, id)
        && request.resource.data.patientId == resource.data.patientId && request.resource.data.version == resource.data.version + 1;
      allow delete: if false;
    }
    function validLabCase(data, id) {
      return data.keys().hasAll(['id','clinicId','patientId','doctorId','labName','work','teeth','sentOn','dueOn','status','createdAt','updatedBy','updatedAt'])
        && data.keys().hasOnly(['id','clinicId','patientId','doctorId','labName','work','teeth','shade','sentOn','dueOn','status','note','createdAt','mergedFrom','updatedBy','updatedAt'])
        && data.id == id && text(data.labName, 100) && text(data.work, 100) && text(data.createdAt, 40)
        && data.teeth is list && data.teeth.size() <= 52 && isDate(data.sentOn) && isDate(data.dueOn) && data.dueOn >= data.sentOn
        && data.status in ['sent','received','fitted','redo','cancelled'] && upTo(data, 'shade', 20) && upTo(data, 'note', 300) && stampedNow(data);
    }
    match /labCases/{id} {
      allow get, list: if canReadClinical(resource.data.clinicId);
      allow create: if hasRole(request.resource.data.clinicId, ['owner','doctor','frontdesk']) && validLabCase(request.resource.data, id)
        && request.resource.data.status == 'sent' && patientInClinic(request.resource.data.patientId, request.resource.data.clinicId);
      allow update: if hasRole(resource.data.clinicId, ['owner','doctor','frontdesk']) && sameClinic() && validLabCase(request.resource.data, id)
        && request.resource.data.patientId == resource.data.patientId;
      allow delete: if false;
    }
    function validRecall(data, id) {
      return data.keys().hasAll(['id','clinicId','patientId','due','reason','status','createdAt','updatedBy','updatedAt'])
        && data.keys().hasOnly(['id','clinicId','patientId','due','reason','status','createdAt','mergedFrom','updatedBy','updatedAt'])
        && data.id == id && isDate(data.due) && text(data.reason, 100) && text(data.createdAt, 40)
        && data.status in ['due','booked','dismissed'] && stampedNow(data);
    }
    match /recalls/{id} {
      allow get, list: if canReadClinical(resource.data.clinicId);
      allow create: if hasRole(request.resource.data.clinicId, ['owner','doctor','frontdesk']) && validRecall(request.resource.data, id)
        && request.resource.data.status == 'due' && patientInClinic(request.resource.data.patientId, request.resource.data.clinicId);
      allow update: if hasRole(resource.data.clinicId, ['owner','doctor','frontdesk']) && sameClinic() && validRecall(request.resource.data, id)
        && request.resource.data.patientId == resource.data.patientId;
      allow delete: if false;
    }
    match /auditLog/{id} {
      allow get, list: if isAdmin() || hasRole(resource.data.clinicId, ['owner']);
      allow create, update, delete: if false;
    }
    match /bills/{id} {
      allow get, list: if canReadBilling(resource.data.clinicId);
      allow create: if billingStaff(request.resource.data.clinicId, ['owner','doctor','frontdesk','billing']) && validBill(request.resource.data, id);
      // The only client change is voiding, by those allowed to correct money. The bill number comes from the assignBillNumber function.
      allow update: if billingStaff(resource.data.clinicId, ['owner','billing']) && resource.data.status == 'active' && request.resource.data.status == 'void'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','voidReason','voidedOn','voidedBy','voidedAt','voidedByUid'])
        && text(request.resource.data.voidReason, 200) && request.resource.data.voidedBy == staffName() && isDate(request.resource.data.voidedOn)
        && request.resource.data.voidedAt == request.time && request.resource.data.voidedByUid == request.auth.uid
        && dayOpen(resource.data.clinicId, request.resource.data.voidedOn);
      allow delete: if false;
    }
    match /ledgerEntries/{id} {
      allow get, list: if canReadBilling(resource.data.clinicId);
      // Payments may be recorded by anyone who bills. Refunds and corrections are for those allowed to correct money.
      allow create: if validLedgerEntry(request.resource.data, id)
        && billingStaff(request.resource.data.clinicId, request.resource.data.kind == 'payment' ? ['owner','doctor','frontdesk','billing'] : ['owner','billing']);
      allow update, delete: if false;
    }
    // Totals are worked out by the closeDay function from the stored entries.
    match /dayClosings/{id} {
      allow get, list: if canReadBilling(resource.data.clinicId);
      allow create, update, delete: if false;
    }
    match /messageDeliveries/{id} {
      allow get, list: if canAccess(resource.data.clinicId);
      allow create, update, delete: if false;
    }
    match /doctorDigestDeliveries/{id} {
      allow get, list: if canAccess(resource.data.clinicId);
      allow create, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
